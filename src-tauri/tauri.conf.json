{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickyBoard",
  "version": "16.3.0",
  "identifier": "cn.qwenwork.stickyboard",
  "build": { "frontendDist": "../dist-web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "daemon",
        "title": "便签台",
        "url": "index.html?w=daemon",
        "width": 1, "height": 1,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/32x32.png"],
    "category": "Productivity",
    "shortDescription": "便签台",
    "longDescription": "把便签钉在 Windows 桌面上的轻量笔记工具（置顶/提醒/标签/Markdown）"
  }
}
