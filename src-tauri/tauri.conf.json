{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickyBoard",
  "version": "16.3.1",
  "identifier": "cn.qwenwork.stickyboard",
  "build": { "frontendDist": "../dist-web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "daemon", "title": "深蓝随便签", "url": "index.html?w=daemon",
        "width": 1, "height": 1, "visible": false, "decorations": false,
        "skipTaskbar": true, "resizable": false, "shadow": false },
      { "label": "panel", "title": "便签墙 · 管理", "url": "index.html?w=panel",
        "width": 1100, "height": 720, "visible": false,
        "resizable": true, "minimizable": true, "closable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/32x32.png"],
    "category": "Productivity",
    "shortDescription": "深蓝随便签",
    "longDescription": "把便签钉在 Windows 桌面上的轻量笔记工具（置顶/提醒/标签/Markdown）"
  }
}
